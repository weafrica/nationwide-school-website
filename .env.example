# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# For the live site, set these same two variables in Vercel:
# Project -> Settings -> Environment Variables.
#
# Both values are safe to expose in the frontend bundle -- they are NOT
# secrets. The anon key only grants what Row Level Security in
# supabase/001_schema.sql allows. Never put the service_role key here or
# in any frontend code -- it belongs only inside the Edge Function
# (supabase/functions/create-student), set as a Supabase secret.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
